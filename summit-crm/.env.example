# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# ── Core ──────────────────────────────────────────────────────────────
# Postgres connection string (Neon via Vercel Marketplace works well).
# Leave empty locally to use a built-in database stored in .data/.
DATABASE_URL=
# Password for signing in to the CRM.
CRM_PASSWORD=
# 32+ random characters, e.g. `openssl rand -hex 32`.
CRM_SESSION_SECRET=
# Vercel Cron sends this as a Bearer token to /api/meta/sync.
CRON_SECRET=
# Sites allowed to post website leads to /api/leads (comma-separated).
CRM_ALLOWED_ORIGINS=https://summitcustomsuits.com,https://www.summitcustomsuits.com,https://summit-customs.vercel.app

# ── Meta Lead Ads (webhook + sync) ────────────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# ── Meta Conversions API (stage events back to Meta) ──────────────────
META_PIXEL_ID=1106836472346765
META_CAPI_TOKEN=
# Optional: shows events under Events Manager → Test events while setting up.
META_TEST_EVENT_CODE=

# ── Meta ad spend reporting ───────────────────────────────────────────
META_AD_ACCOUNT_ID=902291632605494
META_ADS_ACCESS_TOKEN=

# Optional
META_GRAPH_VERSION=v26.0
CRM_NAME=Summit CRM
CRM_CURRENCY=USD

# ── Speed to lead: phone alerts (Web Push) ────────────────────────────
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kobe@summitcustomsuits.com
# Minutes after which a waiting lead triggers a reminder (needs a scheduler hitting /api/speed/nudge)
CRM_NUDGE_MINUTES=5,15,60

# ── Website editing (Website tab) ─────────────────────────────────────
# Fine-grained GitHub token: this repo only, Contents read & write
GITHUB_TOKEN=
# Vercel token for the team that hosts summitcustomsuits.com
VERCEL_TOKEN=
SITE_GITHUB_REPO=mahdyaltalibi5-svg/network-brain
SITE_GITHUB_BRANCH=claude/relaxed-lovelace-jrt1qj
SITE_VERCEL_PROJECT=summit-customs-suits
