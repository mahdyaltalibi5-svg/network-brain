# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# ── Core ──────────────────────────────────────────────────────────────
# Postgres connection string (Neon via Vercel Marketplace works well).
# Leave empty locally to use a built-in database stored in .data/.
DATABASE_URL=
# Password for signing in to the CRM.
CRM_PASSWORD=
# 32+ random characters, e.g. `openssl rand -hex 32`.
CRM_SESSION_SECRET=
# Vercel Cron sends this as a Bearer token to /api/meta/sync.
CRON_SECRET=
# Sites allowed to post website leads to /api/leads (comma-separated).
CRM_ALLOWED_ORIGINS=https://summitcustomsuits.com,https://www.summitcustomsuits.com,https://summit-customs.vercel.app

# ── Meta Lead Ads (webhook + sync) ────────────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# ── Meta Conversions API (stage events back to Meta) ──────────────────
META_PIXEL_ID=1106836472346765
META_CAPI_TOKEN=
# Optional: shows events under Events Manager → Test events while setting up.
META_TEST_EVENT_CODE=

# ── Meta ad spend reporting ───────────────────────────────────────────
META_AD_ACCOUNT_ID=902291632605494
META_ADS_ACCESS_TOKEN=

# Optional
META_GRAPH_VERSION=v25.0
CRM_NAME=Summit CRM
CRM_CURRENCY=USD
