{
  "name": "summit-customs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:html": "node scripts/verify-html.mjs",
    "verify:jsonld": "node scripts/validate-jsonld.mjs",
    "placeholders": "node scripts/list-placeholders.mjs",
    "shots": "node scripts/screenshots.mjs",
    "test": "playwright test",
    "check:phase1": "npm run lint -- --max-warnings 0 && npm run typecheck && npm run build && npm run verify:html && npm run verify:jsonld && npm run shots -- screenshots/p1",
    "prebuild": "node scripts/copy-gpu-benchmarks.mjs",
    "predev": "node scripts/copy-gpu-benchmarks.mjs",
    "intro:frames": "node scripts/intro-frames.mjs",
    "intro:fps": "node scripts/fps.mjs",
    "check:phase2": "npm run lint -- --max-warnings 0 && npm run typecheck && npm run build && npm run verify:html -- --compare && npm run verify:jsonld && npm test && npm run intro:frames -- screenshots/intro"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.1",
    "detect-gpu": "^5.0.70",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "16.4.2",
    "postprocessing": "^6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simplex-noise": "^4.0.3",
    "svg-path-properties": "^2.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "opentype.js": "^2.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
