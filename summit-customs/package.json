{
  "name": "summit-customs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:html": "node scripts/verify-html.mjs",
    "verify:jsonld": "node scripts/validate-jsonld.mjs",
    "placeholders": "node scripts/list-placeholders.mjs",
    "shots": "node scripts/screenshots.mjs",
    "test": "playwright test",
    "check:phase1": "npm run lint -- --max-warnings 0 && npm run typecheck && npm run build && npm run verify:html && npm run verify:jsonld && npm run shots -- screenshots/p1"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
