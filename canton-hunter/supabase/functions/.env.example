# Edge Function secrets. Set in production with:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# CLAUDE_FALLBACKS=off
WORKER_SECRET=            # any long random string; also store it in Vault as worker_secret
EXPO_ACCESS_TOKEN=        # optional (Expo push security)

SHOPIFY_STORE_DOMAIN=     # yourstore.myshopify.com
SHOPIFY_ADMIN_TOKEN=      # Admin API access token from a custom app
SHOPIFY_PUBLIC_DOMAIN=    # optional: your custom domain, e.g. shop.yourbrand.com
# SHOPIFY_API_VERSION=2026-07

META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=       # digits only
META_PAGE_ID=
META_PIXEL_ID=            # optional but recommended
META_INSTAGRAM_ACTOR_ID=  # optional
# META_API_VERSION=v24.0
